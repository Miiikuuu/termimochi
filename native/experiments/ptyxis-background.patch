+/* Paint in tab coordinates, not terminal scroll coordinates. Explicit ANSI
+ * cell backgrounds are subsequently painted by VTE and remain opaque. */
+static void
+research_background_snapshot (PtyxisTab *self,
+                              GtkSnapshot *snapshot,
+                              const GdkRGBA *background,
+                              int width,
+                              int height)
+{
+  GdkRGBA tint = *background;
+  double image_width = gdk_texture_get_width (self->research_background);
+  double image_height = gdk_texture_get_height (self->research_background);
+  double sx = width / image_width;
+  double sy = height / image_height;
+  double scale = self->research_contain ? MIN (sx, sy) : MAX (sx, sy);
+  gboolean canvas = g_strcmp0 (g_getenv ("TERMIMOCHI_RESEARCH_CANVAS"), "1") == 0;
+  float w = canvas ? width : image_width * scale;
+  float h = canvas ? height : image_height * scale;
+
+  tint.alpha = 1.0;
+  gtk_snapshot_push_clip (snapshot, &GRAPHENE_RECT_INIT (0, 0, width, height));
+  gtk_snapshot_append_color (snapshot, &tint, &GRAPHENE_RECT_INIT (0, 0, width, height));
+  gtk_snapshot_append_texture (snapshot, self->research_background,
+                               &GRAPHENE_RECT_INIT ((width - w) / 2, (height - h) / 2, w, h));
+  tint.alpha = self->research_tint;
+  gtk_snapshot_append_color (snapshot, &tint, &GRAPHENE_RECT_INIT (0, 0, width, height));
+  gtk_snapshot_pop (snapshot);
+}
+
 static void
