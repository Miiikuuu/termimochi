+/* Text-only clipboard bridge. Reads are asynchronous, bounded to 1 MiB and
+ * cancelled on focus loss, replacement or destruction. No clipboard logging. */
+#define CLIPBOARD_LIMIT (1024 * 1024)
+typedef struct {
+  struct wlr_data_source base;
+  GBytes *bytes;
+} ClipboardSource;
+typedef struct {
+  GWeakRef widget;
+  GInputStream *stream;
+  GCancellable *cancel;
+  GByteArray *bytes;
+  guint64 epoch;
+  gboolean to_host;
+} ClipboardRead;
+
+static gboolean clipboard_timeout (gpointer data);
+
+static void clipboard_write_done (GObject *stream, GAsyncResult *result, gpointer data)
+{
+  g_output_stream_write_all_finish (G_OUTPUT_STREAM (stream), result, NULL, NULL);
+  g_output_stream_close (G_OUTPUT_STREAM (stream), NULL, NULL);
+  g_bytes_unref (data);
+  g_object_unref (stream);
+}
+static void clipboard_source_send (struct wlr_data_source *base, const char *mime, int32_t fd)
+{
+  (void) mime;
+  ClipboardSource *source = wl_container_of (base, source, base);
+  GOutputStream *stream = g_unix_output_stream_new (fd, TRUE);
+  gsize size;
+  gconstpointer bytes = g_bytes_get_data (source->bytes, &size);
+  GCancellable *cancel = g_cancellable_new ();
+  g_timeout_add_full (G_PRIORITY_DEFAULT, 3000, clipboard_timeout, g_object_ref (cancel), g_object_unref);
+  g_output_stream_write_all_async (stream, bytes ? bytes : "", size, G_PRIORITY_DEFAULT, cancel,
+                                  clipboard_write_done, g_bytes_ref (source->bytes));
+  g_object_unref (cancel);
+}
+static void clipboard_source_destroy (struct wlr_data_source *base)
+{
+  ClipboardSource *source = wl_container_of (base, source, base);
+  g_bytes_unref (source->bytes);
+  g_free (source);
+}
+static const struct wlr_data_source_impl clipboard_impl = {
+  .send = clipboard_source_send, .destroy = clipboard_source_destroy
+};
+static void clipboard_read_free (ClipboardRead *read)
+{
+  g_weak_ref_clear (&read->widget);
+  g_clear_object (&read->stream);
+  g_object_unref (read->cancel);
+  g_byte_array_unref (read->bytes);
+  g_free (read);
+}
+static gboolean clipboard_timeout (gpointer data)
+{
+  g_cancellable_cancel (data);
+  return G_SOURCE_REMOVE;
+}
+static ClipboardRead *clipboard_read_new (CasildaCompositorPrivate *priv, gboolean to_host)
+{
+  if (priv->clipboard_cancel) g_cancellable_cancel (priv->clipboard_cancel);
+  g_clear_object (&priv->clipboard_cancel);
+  priv->clipboard_cancel = g_cancellable_new ();
+  ClipboardRead *read = g_new0 (ClipboardRead, 1);
+  g_weak_ref_init (&read->widget, priv->self);
+  read->cancel = g_object_ref (priv->clipboard_cancel);
+  read->bytes = g_byte_array_new ();
+  read->epoch = ++priv->clipboard_epoch;
+  read->to_host = to_host;
+  g_timeout_add_full (G_PRIORITY_DEFAULT, 3000, clipboard_timeout,
+                     g_object_ref (read->cancel), g_object_unref);
+  return read;
+}
+static void clipboard_read_chunk (GObject *stream, GAsyncResult *result, gpointer data)
+{
+  ClipboardRead *read = data;
+  g_autoptr (GBytes) chunk = g_input_stream_read_bytes_finish (G_INPUT_STREAM (stream), result, NULL);
+  g_autoptr (GtkWidget) widget = g_weak_ref_get (&read->widget);
+  if (!chunk || !widget || g_cancellable_is_cancelled (read->cancel))
+    { clipboard_read_free (read); return; }
+  CasildaCompositorPrivate *priv = GET_PRIVATE (widget);
+  gsize size;
+  gconstpointer bytes = g_bytes_get_data (chunk, &size);
+  if (read->epoch != priv->clipboard_epoch || read->bytes->len + size > CLIPBOARD_LIMIT)
+    { clipboard_read_free (read); return; }
+  if (size)
+    {
+      g_byte_array_append (read->bytes, bytes, size);
+      g_input_stream_read_bytes_async (read->stream, 16384, G_PRIORITY_DEFAULT,
+                                      read->cancel, clipboard_read_chunk, read);
+      return;
+    }
+  if (!g_utf8_validate (read->bytes->data ? (const char *)read->bytes->data : "", read->bytes->len, NULL))
+    { clipboard_read_free (read); return; }
+  if (read->to_host)
+    {
+      g_byte_array_append (read->bytes, (const guint8 *)"", 1);
+      priv->clipboard_setting = TRUE;
+      gdk_clipboard_set_text (gtk_widget_get_clipboard (widget), (const char *)read->bytes->data);
+      priv->clipboard_setting = FALSE;
+    }
+  else
+    {
+      ClipboardSource *source = g_new0 (ClipboardSource, 1);
+      wlr_data_source_init (&source->base, &clipboard_impl);
+      source->bytes = g_bytes_new (read->bytes->data, read->bytes->len);
+      const char *mimes[] = {"text/plain;charset=utf-8", "text/plain", "UTF8_STRING"};
+      for (guint i = 0; i < G_N_ELEMENTS (mimes); i++)
+        {
+          char **slot = wl_array_add (&source->base.mime_types, sizeof (char *));
+          *slot = g_strdup (mimes[i]);
+        }
+      wlr_seat_set_selection (priv->seat, &source->base, wl_display_next_serial (priv->wl_display));
+    }
+  clipboard_read_free (read);
+}
+static void clipboard_host_ready (GObject *clipboard, GAsyncResult *result, gpointer data)
+{
+  ClipboardRead *read = data;
+  read->stream = gdk_clipboard_read_finish (GDK_CLIPBOARD (clipboard), result, NULL, NULL);
+  if (!read->stream) { clipboard_read_free (read); return; }
+  g_input_stream_read_bytes_async (read->stream, 16384, G_PRIORITY_DEFAULT,
+                                  read->cancel, clipboard_read_chunk, read);
+}
+static void clipboard_host_changed (GdkClipboard *clipboard, GtkWidget *widget)
+{
+  CasildaCompositorPrivate *priv = GET_PRIVATE (widget);
+  if (priv->clipboard_setting || !gtk_widget_has_focus (priv->self)) return;
+  const char *mimes[] = {"text/plain;charset=utf-8", "text/plain", "UTF8_STRING", NULL};
+  ClipboardRead *read = clipboard_read_new (priv, FALSE);
+  gdk_clipboard_read_async (clipboard, mimes, G_PRIORITY_DEFAULT, read->cancel, clipboard_host_ready, read);
+}
+static void clipboard_focus_changed (GtkWidget *widget, GParamSpec *pspec, CasildaCompositorPrivate *priv)
+{
+  (void) pspec;
+  if (gtk_widget_has_focus (widget))
+    clipboard_host_changed (gtk_widget_get_clipboard (widget), widget);
+  else if (priv->clipboard_cancel)
+    g_cancellable_cancel (priv->clipboard_cancel);
+}
+
