+typedef struct {
+  CasildaCompositorPrivate *priv;
+  struct wlr_text_input_v3 *input;
+  struct wl_listener enable, disable, commit, destroy;
+} TextInputBridge;
+
+static void
+im_commit (GtkIMContext *context, const char *text, CasildaCompositorPrivate *priv)
+{
+  g_debug ("Native IM commit event");
+  (void) context;
+  if (!priv->active_text_input || !priv->active_text_input->current_enabled)
+    return;
+  wlr_text_input_v3_send_preedit_string (priv->active_text_input, "", 0, 0);
+  wlr_text_input_v3_send_commit_string (priv->active_text_input, text);
+  wlr_text_input_v3_send_done (priv->active_text_input);
+}
+
+static void
+im_preedit (GtkIMContext *context, CasildaCompositorPrivate *priv)
+{
+  g_debug ("Native IM preedit event");
+  g_autofree char *text = NULL;
+  PangoAttrList *attrs = NULL;
+  int cursor = 0;
+  if (!priv->active_text_input || !priv->active_text_input->current_enabled)
+    return;
+  gtk_im_context_get_preedit_string (context, &text, &attrs, &cursor);
+  if (attrs) pango_attr_list_unref (attrs);
+  cursor = g_utf8_offset_to_pointer (text, cursor) - text;
+  wlr_text_input_v3_send_preedit_string (priv->active_text_input, text, cursor, cursor);
+  wlr_text_input_v3_send_done (priv->active_text_input);
+}
+
+static void
+text_input_update (TextInputBridge *bridge)
+{
+  CasildaCompositorPrivate *priv = bridge->priv;
+  struct wlr_text_input_v3 *input = bridge->input;
+  if (!input->current_enabled || !input->focused_surface)
+    return;
+  if (priv->active_text_input != input)
+    {
+      gtk_im_context_reset (priv->im_context);
+      priv->active_text_input = input;
+      gtk_event_controller_key_set_im_context (GTK_EVENT_CONTROLLER_KEY (priv->key_controller), priv->im_context);
+      if (gtk_widget_has_focus (priv->self))
+        gtk_im_context_focus_in (priv->im_context);
+    }
+  struct wlr_box box = input->current.cursor_rectangle;
+  /* Client coordinates -> compositor widget coordinates (candidate anchoring). */
+  struct wlr_xdg_toplevel *xdg = wlr_xdg_toplevel_try_from_wlr_surface (input->focused_surface);
+  if (xdg && xdg->base->data)
+    {
+      CasildaCompositorToplevel *top = xdg->base->data;
+      box.x += top->x; box.y += top->y;
+    }
+  GdkRectangle rect = {box.x, box.y, MAX (box.width, 1), MAX (box.height, 1)};
+  gtk_im_context_set_cursor_location (priv->im_context, &rect);
+  if (input->current.surrounding.text)
+    gtk_im_context_set_surrounding_with_selection (priv->im_context,
+      input->current.surrounding.text, -1, input->current.surrounding.cursor, input->current.surrounding.anchor);
+}
+
+static void
+text_input_enable (struct wl_listener *listener, void *data)
+{
+  (void) data;
+  TextInputBridge *bridge = wl_container_of (listener, bridge, enable);
+  g_debug ("Native text input enabled");
+  text_input_update (bridge);
+}
+
+static void
+text_input_commit (struct wl_listener *listener, void *data)
+{
+  (void) data;
+  TextInputBridge *bridge = wl_container_of (listener, bridge, commit);
+  text_input_update (bridge);
+}
+
+static void
+text_input_deactivate (TextInputBridge *bridge)
+{
+  CasildaCompositorPrivate *priv = bridge->priv;
+  if (priv->active_text_input != bridge->input)
+    return;
+  priv->active_text_input = NULL;
+  if (priv->im_context)
+    {
+      gtk_im_context_reset (priv->im_context);
+      gtk_im_context_focus_out (priv->im_context);
+    }
+  if (priv->key_controller)
+    gtk_event_controller_key_set_im_context (GTK_EVENT_CONTROLLER_KEY (priv->key_controller), NULL);
+}
+
+static void
+text_input_disable (struct wl_listener *listener, void *data)
+{
+  (void) data;
+  TextInputBridge *bridge = wl_container_of (listener, bridge, disable);
+  g_debug ("Native text input disabled");
+  text_input_deactivate (bridge);
+}
+
+static void
+text_input_destroy (struct wl_listener *listener, void *data)
+{
+  (void) data;
+  TextInputBridge *bridge = wl_container_of (listener, bridge, destroy);
+  text_input_deactivate (bridge);
+  wl_list_remove (&bridge->enable.link);
+  wl_list_remove (&bridge->disable.link);
+  wl_list_remove (&bridge->commit.link);
+  wl_list_remove (&bridge->destroy.link);
+  g_free (bridge);
+}
+
+static void
+text_input_new (struct wl_listener *listener, void *data)
+{
+  CasildaCompositorPrivate *priv = wl_container_of (listener, priv, new_text_input);
+  TextInputBridge *bridge = g_new0 (TextInputBridge, 1);
+  bridge->priv = priv; bridge->input = data;
+  bridge->enable.notify = text_input_enable;
+  bridge->disable.notify = text_input_disable;
+  bridge->commit.notify = text_input_commit;
+  bridge->destroy.notify = text_input_destroy;
+  wl_signal_add (&bridge->input->events.enable, &bridge->enable);
+  wl_signal_add (&bridge->input->events.disable, &bridge->disable);
+  wl_signal_add (&bridge->input->events.commit, &bridge->commit);
+  wl_signal_add (&bridge->input->events.destroy, &bridge->destroy);
+  text_input_focus (priv, priv->seat->keyboard_state.focused_surface);
+}
+
+static void
+im_focus_changed (GtkWidget *widget, GParamSpec *pspec, CasildaCompositorPrivate *priv)
+{
+  (void) pspec;
+  if (!priv->im_context) return;
+  if (gtk_widget_has_focus (widget) && priv->active_text_input)
+    gtk_im_context_focus_in (priv->im_context);
+  else
+    {
+      gtk_im_context_reset (priv->im_context);
+      gtk_im_context_focus_out (priv->im_context);
+    }
+}
