{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // TermiMochi's own starting point, using the same native modules as the
    // bundled upstream presets. Artwork and theme accents are supplied by the app.
    "display": {
        "separator": "  ",
        "key": { "width": 12 },
        "size": { "ndigits": 1 },
        "freq": { "ndigits": 1 }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        { "type": "kernel", "format": "{release}" },
        "uptime",
        { "type": "packages", "combined": true },
        "shell",
        "terminal",
        { "type": "display", "compactType": "original", "key": "Display" },
        "de",
        "wm",
        "break",
        { "type": "cpu", "format": "{name}" },
        { "type": "gpu", "key": "GPU", "format": "{name}" },
        { "type": "memory", "format": "{used} / {total} ({percentage})" },
        { "type": "disk", "key": "Disk (/)", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },
        "break",
        { "type": "colors", "paddingLeft": 0, "symbol": "block" }
    ]
}
